[Unit]
Description=Auctionscan API (Fast API)
After=network.target

[Service]
Type=simple
User=svc-auctionscan
Group=svc-auctionscan
WorkingDirectory=/opt/auctionscan
EnvironmentFile=/etc/auctionscan.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/auctionscan/backend/.venv/bin/uvicorn backend.api.app:app --host 127.0.0.1 --port 8010
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/auctionscan
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
