[Unit]
Description=Auctionscan Indexer (%i)
After=network.target

[Service]
Type=simple
User=svc-auctionscan
Group=svc-auctionscan
WorkingDirectory=/opt/auctionscan
EnvironmentFile=/etc/auctionscan.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/auctionscan/backend/.venv/bin/python -m backend.indexer.app --network %i --watch --log-level INFO
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/auctionscan
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
