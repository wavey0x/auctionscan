# =============================================================================
# AUCTIONSCAN ENVIRONMENT
# =============================================================================
# Copy this file to .env and fill in the values you need.

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------

# SQLite path for the API and indexer. Relative paths are resolved from repo
# root when running the Python entrypoints from the repo root.
AUCTIONSCAN_DB_PATH=backend/data/auctionscan.sqlite3

# CORS for the API.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# RPC URLs referenced by backend/src/backend/indexer/config.py.
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=
BERACHAIN_RPC_URL=
KATANA_RPC_URL=
ANVIL_RPC_URL=http://localhost:8545

# Etherscan key used by scripts/download_auction_artifacts.py.
ETHERSCAN_API_KEY=

# Hosted token metadata and logo backfill service.
PRICES_API_BASE_URL=https://prices.wavey.info
PRICES_API_KEY=

# -----------------------------------------------------------------------------
# UI
# -----------------------------------------------------------------------------

# Keep /api for same-origin deployments.
VITE_API_BASE_URL=/api

# Local Vite proxy target for the UI.
VITE_API_PROXY_TARGET=http://127.0.0.1:8001

# Explicit docs URL for footer links. Leave blank to infer from proxy target.
VITE_API_DOCS_URL=http://127.0.0.1:8001/docs
