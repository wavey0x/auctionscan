[Unit]
Description=Auctionscan API (Fast API)
After=network.target

[Service]
Type=simple
User=svc-auctionscan
Group=svc-auctionscan
WorkingDirectory=/home/wavey/auctionscan
EnvironmentFile=/home/wavey/auctionscan/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/wavey/auctionscan/backend/.venv/bin/uvicorn backend.api.app:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
